{
  "name": "glassbox",
  "version": "1.0.0",
  "description": "A desktop app for Claude Code: watch every plan, edit and command as it happens, and steer it while it works.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "electron scripts/make-icons.mjs",
    "dist": "electron-vite build && electron-builder --win dir",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "dist:installer": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.282",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "productName": "Glassbox",
  "author": "Harry West <harrywest@live.co.uk>",
  "build": {
    "appId": "com.harrywest.glassbox.desktop",
    "productName": "Glassbox",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!node_modules/{mermaid,@mermaid-js,monaco-editor,@monaco-editor,react,react-dom,marked,dompurify,@xterm,@vscode,@fontsource,@fontsource-variable,cytoscape,cytoscape-cose-bilkent,cytoscape-fcose,elkjs,katex,khroma,dagre-d3-es,@iconify,roughjs,langium,chevrotain,@chevrotain}/**",
      "!node_modules/d3*/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/!(${platform})/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/!(${arch})/**",
      "!node_modules/node-pty/prebuilds/!(${platform}-${arch})/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/node-pty/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "resources/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "harrywestt",
        "repo": "glassbox"
      }
    ],
    "npmRebuild": false,
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glassbox",
      "artifactName": "Glassbox-Setup-${version}.${ext}",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Glassbox-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Glassbox uses the microphone when you hold Space to dictate a message. Speech is transcribed on this Mac.",
        "NSAppleEventsUsageDescription": "Glassbox opens Terminal so you can sign in to Claude or GitHub."
      }
    },
    "dmg": {
      "title": "Glassbox ${version}"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "icons",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harrywestt/glassbox.git"
  },
  "homepage": "https://github.com/harrywestt/glassbox",
  "license": "MIT"
}
